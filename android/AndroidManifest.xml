<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  NOTICE: Full documentation, design decisions, and fix history for this file
  live in docs/android.md, section "android/AndroidManifest.xml"
  ============================================================================
  @MIN_SDK@, @TARGET_SDK@, @VERSION_CODE@ and @VERSION_NAME@ are filled in by scripts/build_android.sh.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.midmanstudio.towerofbabylon"
    android:versionCode="@VERSION_CODE@"
    android:versionName="@VERSION_NAME@">

    <uses-sdk
        android:minSdkVersion="@MIN_SDK@"
        android:targetSdkVersion="@TARGET_SDK@" />

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <!-- Sockets: LAN discovery and the game's network transports (src/net) cannot open one without it. A normal permission: granted at
         install, no prompt. Nothing else is asked for on purpose: the Wi-Fi state and multicast permissions are for Java calls (WifiManager) and
         the app has no Java (android:hasCode="false"); the native code reads the interfaces with getifaddrs. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Tower of Babylon"
        android:hasCode="false"
        android:extractNativeLibs="true">

        <activity
            android:name="android.app.NativeActivity"
            android:label="Tower of Babylon"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode">

            <meta-data android:name="android.app.lib_name" android:value="main" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
