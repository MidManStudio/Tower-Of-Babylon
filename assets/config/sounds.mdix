// Brought to u by MidManStudio
// Every sound in the game, as a recipe for the synthesiser (src/audio/synth.c): there are no sound files.
// Notes on writing this file are in docs/audio.md. Read a sound as a sound line, then one line per layer under it.
@CONFIG(
  version  -> "1.0.0"
  author   -> "MidManStudio"
  features -> "quickfuncs,enums,data"
)

// Written out by value because the C side mirrors them (src/audio/audio_core.h and synth.h).
@ENUMS(
  Cat  { SFX = 0, UI = 1, AMBIENT = 2, VOICE = 3 }
  Wave { SINE = 0, SQUARE = 1, SAW = 2, TRIANGLE = 3, NOISE = 4 }
)

// snd(id, category, volume, pitch_jitter, voices, variants, loop, loop_fade, falloff_start, falloff_end, duration)
//   category        which volume slider it sits under (Cat)
//   volume          0..2 before the category and master volumes
//   pitch_jitter    each play is detuned by up to this fraction either way, so a repeated sound never repeats exactly
//   voices          how many copies may sound at once; the oldest is cut off when they are all busy
//   variants        how many different takes are rendered (different noise) and played in turn, never the same twice
//   loop, loop_fade a looping sound (it needs a duration); the end is cross-faded into the start over loop_fade seconds
//   falloff_*       metres: full volume out to _start, silent at _end; used when a sound is played AT a place
//                   (0 and 0 = the sound has no place, it is played flat, like your own footsteps)
//   duration        total seconds; 0 = as long as the longest layer
// lyr(wave, f0, f1, level, delay, attack, decay, length, lp0, lp1, drive): one layer of the sound above it, up to four
//   wave            Wave: SINE, SQUARE, SAW, TRIANGLE or NOISE
//   f0, f1          Hz at the start and the end of the layer; the pitch glides between them (ignored for NOISE)
//   level           loudness of this layer inside the sound
//   delay           seconds before it starts
//   attack, decay   seconds to rise; then the level falls to 1/e every `decay` seconds
//   length          seconds it lasts; 0 = until it has faded to -60 dB
//   lp0, lp1        low-pass cutoff in Hz at the start and the end (the sweep is the "shape" of a gunshot); 0 and 0 = none
//   drive           0 = clean; 1 to 3 = grit
@QUICKFUNCS(

  ~snd<object>(_id, _cat<enum>, _vol<float>, _jit<float>, _voices<int>, _vars<int>, _loop<bool>, _fade<float>, _near<float>, _far<float>, _dur<float>) {
    return { kind = 0, id = _id, category = _cat, volume = _vol, pitch_jitter = _jit, voices = _voices, variants = _vars,
             loop = _loop, loop_fade = _fade, falloff_start = _near, falloff_end = _far, duration = _dur }
  }

  ~lyr<object>(_wave<enum>, _f0<float>, _f1<float>, _lvl<float>, _dly<float>, _atk<float>, _dec<float>, _len<float>, _lp0<float>, _lp1<float>, _drv<float>) {
    return { kind = 1, wave = _wave, f0 = _f0, f1 = _f1, level = _lvl, delay = _dly, attack = _atk, decay = _dec, length = _len,
             lp0 = _lp0, lp1 = _lp1, drive = _drv }
  }

)

